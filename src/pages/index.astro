---
import { Font } from "astro:assets";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>jones' site</title>
        <Font cssVariable="--font-doto" preload />
        <Font cssVariable="--font-b612-mono" preload />
        <style>
            body {
                margin: 0;
                padding: 1.5rem;
                background: #0a1630;
                color: #fff8f0;
                font-family: var(--font-b612-mono);
            }

            h1 {
                margin: 0;
                font-family: var(--font-doto);
                font-size: 2.5rem;
                font-weight: 700;
            }
        </style>
    </head>
    <body>
        <h1>guillaume-jones</h1>
        <p>Dev working on various web & app projects since 2022.</p>
    </body>
</html>
