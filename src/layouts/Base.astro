---
import { Font } from "astro:assets";
import Sidebar from "../components/Sidebar.astro";

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title ? title + " | guillaume-jones" : "guillaume-jones"}</title>
    <Font cssVariable="--font-b612-mono" preload />
    <style is:global>
      body {
        --navy: #0a1630;
        --navy-light: #18284c;
        --cream: #fff8f0;
        --bg: var(--navy);
        --fg: var(--cream);
        --bg-light: var(--navy-light);
        --pixel: 0.25rem;
        margin: 0;
        padding: 0 0 calc(5.5rem + 1px);
        background: var(--bg);
        color: var(--fg);
        font-family: var(--font-b612-mono);
      }

      @media (min-width: 40rem) {
        body {
          padding: 0 0 0 calc(5rem + 1px);
        }
      }

      main {
        padding: 1rem 1rem 4rem;
      }

      main > :first-child {
        margin-top: 0;
      }

      main > :last-child {
        margin-bottom: 0;
      }

      h1,
      h2,
      h3,
      h4 {
        margin: 1.25rem 0 0.875rem;
      }

      p {
        margin: 0 0 0 0.25rem;
        font-size: 0.9rem;
        line-height: 1.4;
      }

      h1 {
        font-size: calc(var(--pixel) * 10);
      }

      h2 {
        font-size: 1.875rem;
      }

      h3 {
        font-size: 1.375rem;
      }

      h4 {
        font-size: 1rem;
      }

      dl {
        display: grid;
        grid-template-columns: max-content 1fr;
        align-items: baseline;
        line-height: 1.4;
        gap: 0.75rem 0.5rem;
        font-size: 0.9rem;
      }

      dt {
        opacity: 0.7;
      }

      a {
        color: inherit;
        text-underline-offset: 0.2em;
      }

      :is(p, dd) a:hover {
        background: var(--fg);
        color: var(--bg);
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <Sidebar />
    <main>
      <slot />
    </main>
  </body>
</html>
