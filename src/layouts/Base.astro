---
import { Font } from "astro:assets";
import Sidebar from "../components/Sidebar.astro";

const { title = "jones' site" } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
        <Font cssVariable="--font-b612-mono" preload />
        <style is:global>
            body {
                --navy: #0a1630;
                --navy-light: #18284c;
                --cream: #fff8f0;
                --bg: var(--navy);
                --fg: var(--cream);
                --bg-light: var(--navy-light);
                --pixel: 0.25rem;
                margin: 0;
                padding: 0 0 calc(5.5rem + 1px);
                background: var(--bg);
                color: var(--fg);
                font-family: var(--font-b612-mono);
            }

            @media (min-width: 40rem) {
                body {
                    padding: 0 0 0 calc(5rem + 1px);
                }
            }

            main {
                padding: 1rem 1rem 4rem;
            }

            main > :first-child {
                margin-top: 0;
            }

            main > :last-child {
                margin-bottom: 0;
            }

            h1,
            h2,
            h3,
            h4 {
                margin: 0.5rem 0 0.5rem;
            }

            p {
                margin: 0 0 0 0.25rem;
            }

            h1 {
                font-size: calc(var(--pixel) * 10);
            }

            h2 {
                font-size: 1.75rem;
            }

            h3 {
                font-size: 1.375rem;
            }

            h4 {
                font-size: 1rem;
            }
        </style>
    </head>
    <body>
        <Sidebar />
        <main>
            <slot />
        </main>
    </body>
</html>
