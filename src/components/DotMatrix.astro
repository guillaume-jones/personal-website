---
import { cursor, dotGrid, dotMatrix } from "../lib/dotMatrix";

const { as: Tag = "h1", grid, ...rest } = Astro.props;
const html = (await Astro.slots.render("default")) ?? "";
const entities: Record<string, string> = { amp: "&", lt: "<", gt: ">", quot: '"', "#39": "'" };
const text = html
    .replace(/<[^>]*>/g, "")
    .replace(/&(amp|lt|gt|quot|#39);/g, (_, entity) => entities[entity])
    .trim();
const { cols, rows, lit, frame } = grid ? dotGrid(grid) : dotMatrix(text);
const pattern = `dot-matrix-${crypto.randomUUID()}`;
---

<Tag {...rest}>
    <span set:html={html} />
    <svg class="dot-matrix" viewBox={`0 0 ${cols} ${rows}`} style={`height: ${rows / 10}em`} aria-hidden="true">
        <pattern id={pattern} width="1" height="1" patternUnits="userSpaceOnUse">
            <rect class="off" width=".8" height=".8" />
        </pattern>
        <path class="frame" d={frame} fill={`url(#${pattern})`} />
        <path class="on lit" d={lit} />
        <g class="cursor">
            {cursor.map(([x, y]) => <rect class="on" x={x} y={y} width=".8" height=".8" />)}
        </g>
    </svg>
</Tag>

<style>
    span {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    svg {
        display: block;
        cursor: none;
    }

    .off {
        fill: var(--bg-light);
    }

    .on {
        fill: var(--fg);
    }

    .cursor {
        visibility: hidden;
    }

    svg:hover .cursor {
        visibility: visible;
    }
</style>

<script>
    type Cell = [number, number];

    for (const svg of document.querySelectorAll<SVGSVGElement>(".dot-matrix")) {
        const frame = svg.querySelector<SVGPathElement>(".frame")!;
        const cursor = svg.querySelector<SVGGElement>(".cursor")!;
        const dots = [...cursor.querySelectorAll("rect")];
        const lit = new Set(svg.querySelector(".lit")!.getAttribute("d")!.match(/\d+ \d+/g));
        const touched = new Set<string>();
        const cols = svg.viewBox.baseVal.width;
        const isOn = (key: string) => lit.has(key) !== touched.has(key);
        let at: Cell = [NaN, NaN];

        const cellAt = (e: PointerEvent): Cell => {
            const rect = svg.getBoundingClientRect();
            const cell = rect.width / cols;
            return [Math.floor((e.clientX - rect.left) / cell), Math.floor((e.clientY - rect.top) / cell)];
        };

        const touch = ([cx, cy]: Cell) => {
            for (const dot of dots) {
                const [x, y] = [cx + dot.x.baseVal.value, cy + dot.y.baseVal.value];
                const key = `${x} ${y}`;
                if (touched.has(key) || !frame.isPointInFill(new DOMPoint(x + 0.4, y + 0.4))) continue;
                touched.add(key);
                const cell = dot.cloneNode() as SVGRectElement;
                cell.setAttribute("x", `${x}`);
                cell.setAttribute("y", `${y}`);
                cell.setAttribute("class", isOn(key) ? "on" : "off");
                cursor.before(cell);
            }
        };

        const render = () => {
            cursor.style.translate = `${at[0]}px ${at[1]}px`;
            for (const dot of dots) {
                const key = `${at[0] + dot.x.baseVal.value} ${at[1] + dot.y.baseVal.value}`;
                dot.setAttribute("class", isOn(key) ? "off" : "on");
            }
        };

        if (!svg.closest("a, button")) {
            svg.style.touchAction = "none";
            svg.addEventListener("pointerdown", (e) => {
                svg.setPointerCapture(e.pointerId);
                at = cellAt(e);
                touch(at);
                render();
            });
        }

        svg.addEventListener("pointermove", (e) => {
            const [x, y] = cellAt(e);
            const [lx, ly] = at;
            if (x === lx && y === ly) return;
            if (svg.hasPointerCapture(e.pointerId)) {
                const steps = Math.max(Math.abs(x - lx), Math.abs(y - ly));
                for (let i = 1; i <= steps; i++) {
                    touch([Math.round(lx + ((x - lx) * i) / steps), Math.round(ly + ((y - ly) * i) / steps)]);
                }
            }
            at = [x, y];
            render();
        });
    }
</script>
