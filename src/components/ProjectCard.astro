---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import DotMatrix from "./DotMatrix.astro";

interface Props {
    href: string;
    image: ImageMetadata;
    title: string;
    description: string;
}

const { href, image, title, description } = Astro.props;
---

<a href={href}>
    <div class="frame" aria-hidden="true">
        <svg>
            <rect class="track" width="100%" height="100%" />
            <rect class="snake" width="100%" height="100%" pathLength="100" />
        </svg>
    </div>
    <div class="screen">
        <Image src={image} alt="" widths={[480, 960]} sizes="(min-width: 40rem) 50vw, 100vw" />
    </div>
    <DotMatrix as="h2">{title}</DotMatrix>
    <p>{description}</p>
</a>

<style>
    a {
        position: relative;
        container-type: inline-size;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 1rem;
        color: var(--fg);
        text-decoration: none;
    }

    .frame {
        position: absolute;
        inset: 0;
        pointer-events: none;
        --dot: transparent calc(var(--pixel) * 0.1), #000 0 calc(var(--pixel) * 0.9), transparent 0;
        mask:
            linear-gradient(to right, var(--dot)) 0 0 / var(--pixel) var(--pixel) round,
            linear-gradient(to bottom, var(--dot)) 0 0 / var(--pixel) var(--pixel) round;
        mask-composite: intersect;
    }

    svg {
        position: absolute;
        inset: calc(var(--pixel) / 2);
        width: calc(100% - var(--pixel));
        height: calc(100% - var(--pixel));
        overflow: visible;
    }

    rect {
        fill: none;
        stroke-width: var(--pixel);
    }

    .track {
        stroke: var(--bg-light);
    }

    .snake {
        visibility: hidden;
        stroke: var(--fg);
        stroke-dasharray: 8 92;
    }

    a:hover .snake {
        visibility: visible;
        animation: zip 3s linear infinite;
    }

    @keyframes zip {
        to {
            stroke-dashoffset: -100;
        }
    }

    .screen {
        position: relative;
        width: round(down, 100cqi, var(--pixel));
        height: round(down, 52.5cqi, var(--pixel));
        overflow: hidden;
    }

    .screen::before,
    .screen::after {
        content: "";
        position: absolute;
        inset: 0;
    }

    .screen::before {
        border: calc(var(--pixel) * 2) solid var(--bg);
        transition: border-width 0.2s steps(2);
    }

    a:hover .screen::before {
        border-width: 0;
    }

    .screen::after {
        background:
            linear-gradient(to right, transparent calc(var(--pixel) * 0.8), var(--bg) 0) 0 0 / var(--pixel) var(--pixel),
            linear-gradient(to bottom, transparent calc(var(--pixel) * 0.8), var(--bg) 0) 0 0 / var(--pixel) var(--pixel);
    }

    img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    h2,
    p {
        margin: 0;
    }
</style>
